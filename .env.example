# =============================================================================
# Business Pilot AI — Environment Variables
# Copy this file to .env.local (development) or set these in your host's
# environment variable settings (production/Hostinger). Never commit real
# values — this file must only ever contain empty placeholders.
# =============================================================================

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Real support address shown in the footer and used as the Contact page's
# reply-to. Set this to your actual support inbox before going live —
# it intentionally has no hardcoded fallback claiming to be a real address.
NEXT_PUBLIC_CONTACT_EMAIL=
# Where the /contact form's real submissions get sent (via Resend).
CONTACT_FORM_RECIPIENT=

# --- Supabase (auth, database, storage) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs (primary voice provider) ----------------------------------
ELEVENLABS_API_KEY=
# Used automatically if a business's selected voice is no longer available
# in the live ElevenLabs catalog (see lib/voice/index.ts). A stock
# ElevenLabs voice id is a safe default, e.g. Rachel: 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_FALLBACK_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Which registered provider is primary — must stay 'elevenlabs' for
# production. Only change this for local testing against the OpenAI TTS
# fallback provider (see lib/voice/index.ts).
VOICE_PROVIDER=elevenlabs

# --- Vapi (voice AI call orchestration) ------------------------------------
VAPI_API_KEY=
# Verifies inbound webhook calls are really from Vapi (set the same value
# in your Vapi assistant's "server URL secret" field).
VAPI_WEBHOOK_SECRET=
# Optional global default assistant id — used only as a fallback when a
# business record doesn't yet have its own businesses.vapi_assistant_id
# (useful for local/staging testing with a single shared assistant before
# per-business provisioning is wired up).
VAPI_ASSISTANT_ID=

# --- Stripe (payments) ------------------------------------------------------
# Use sk_test_ keys for staging — see HOSTINGER_DEPLOYMENT.md
# "Staging mode" section. Never use live (sk_live_) keys until
# you are ready to accept real customer charges. Payment is via Stripe's
# hosted Checkout redirect (lib/stripe.ts / app/api/stripe/checkout) — no
# client-side Stripe.js publishable key is used anywhere in this codebase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Connect (BYO payments — "Connect Stripe" one-click OAuth flow).
# From your Stripe dashboard's Connect settings, not the regular API keys.
STRIPE_CONNECT_CLIENT_ID=

# --- Twilio (SMS + call forwarding) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Phone Management module -------------------------------------------------
# 32-byte key, base64-encoded, used to encrypt BYO Twilio Auth Tokens at
# rest (lib/crypto.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# Additional variables required by existing features (not in the core
# production checklist, but genuinely required for the app to function).
# =============================================================================

# OpenAI — powers knowledge-base embeddings/answers (lib/rag.ts) and is also
# usable as a fallback voice provider (lib/voice/providers/openai.ts).
OPENAI_API_KEY=

# Google Calendar OAuth — appointment scheduling for service businesses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Resend — transactional email (receipts, confirmations).
RESEND_API_KEY=
