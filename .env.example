# ---------------------------------------------------------------------------
# Smart USA Visa — environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never exposed to the client. Used for
# admin operations, signed URLs, and the PDF/package generation pipeline.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Developers -> Webhooks -> your endpoint's signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (transactional email: verification, password reset, receipts,
# translation order updates)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Smart USA Visa <notifications@smartusavisa.com>"

# Google OAuth (configured as a provider in Supabase Auth; these values
# are entered into the Supabase dashboard, not read directly by the app,
# but are kept here for reference/local testing of the OAuth app itself)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Rate limiting (optional — falls back to an in-memory limiter if unset,
# which is fine for a single instance but not for multi-instance deploys)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
